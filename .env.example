# Copy to .env (git-ignored), fill in, then load it before starting Rust:
#   set -a; source .env; set +a; cargo run --locked
# The server does not read .env by itself. On a host, use its secret settings instead.
# Never put these values in frontend code, commits, chat, or screenshots.
PLANNER_PROVIDER=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Optional overrides (defaults shown)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
# WATSONX_API_VERSION=2024-03-14
# WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
